# Copie para .env.local e preencha com os valores de `npm run sb:status`
# (local) ou do painel do projeto Supabase (produção).

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Chave pública (anon / publishable). Pode ir para o navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de serviço (service_role / secret). IGNORA o RLS.
# Usada só no servidor (Server Actions da área /admin). NUNCA prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
